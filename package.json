{
  "name": "my-aws-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "precommit": "lint-staged",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:terms": "node scripts/test-terms.js",
    "test:terms:unit": "node scripts/test-terms.js unit",
    "test:terms:integration": "node scripts/test-terms.js integration",
    "test:terms:e2e": "node scripts/test-terms.js e2e",
    "test:terms:accessibility": "node scripts/test-terms.js accessibility",
    "test:terms:cross-browser": "node scripts/test-terms.js crossBrowser",
    "test:terms:edge-cases": "node scripts/test-terms.js edgeCases",
    "test:terms:error-handling": "node scripts/test-terms.js errorHandling",
    "test:terms:all": "node scripts/test-terms.js all",
    "test:terms:watch": "node scripts/test-terms.js unit --watch",
    "test:terms:coverage": "node scripts/test-terms.js all --coverage",
    "prepare": "husky install",
    "clean": "rimraf dist node_modules",
    "start": "npm run dev"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-toast": "^1.2.24",
    "@radix-ui/react-tooltip": "^1.3.0",
    "astro": "^7.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.473.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-wiki-link": "^2.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^11.0.13",
    "@shadcn/ui": "^0.0.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-astro": "^1.7.0",
    "husky": "^8.0.3",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^13.3.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^5.0.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "update-browserslist-db": "^1.3.4",
    "vitest": "^5.0.3"
  }
}