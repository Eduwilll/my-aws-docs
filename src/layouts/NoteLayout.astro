---
// src/layouts/NoteLayout.astro
import BaseLayout from "./BaseLayout.astro";
const { frontmatter, slug } = Astro.props;
---

<BaseLayout title={frontmatter.title}>
  <div class="flex min-h-screen">
    <!-- Sidebar Navigation -->
    <aside
      class="w-64 bg-[hsl(var(--sidebar-bg))] border-r border-border hidden md:block p-6 overflow-y-auto transition-colors duration-300"
    >
      <div class="mb-6">
        <input
          type="search"
          placeholder="Buscar notas..."
          class="w-full px-4 py-2 rounded-md border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <nav>
        <slot name="sidebar" />
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-8 bg-background">
      <article class="prose prose-slate dark:prose-invert max-w-none">
        <div class="mb-8">
          <h1 class="text-4xl font-bold text-foreground mb-4">
            {frontmatter.title}
          </h1>
          {
            frontmatter.tags && (
              <div class="flex gap-2">
                {frontmatter.tags.map((tag: string) => (
                  <span class="note-tag">#{tag}</span>
                ))}
              </div>
            )
          }
        </div>

        <div class="note-content">
          <slot />
        </div>

        <!-- Backlinks & Related Notes -->
        <div class="mt-12 pt-6 border-t">
          <h2 class="text-2xl font-semibold mb-4">Links Relacionados</h2>
          <slot name="backlinks" />
        </div>
      </article>
    </main>
  </div>
</BaseLayout>

<style>
  .note-content :global(a) {
    color: #2563eb;
    text-decoration: underline;
  }

  .note-content :global(h2) {
    font-size: 1.875rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .note-content :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .note-content :global(ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .note-content :global(pre) {
    @apply bg-muted p-4 rounded-md overflow-x-auto mb-4 border border-border;
  }
</style>
