---
// src/layouts/NoteLayout.astro
import BaseLayout from "./BaseLayout.astro";
const { frontmatter, slug, headings = [] } = Astro.props;

// Filter headings for ToC (h2 and h3)
const tocHeadings = headings.filter((h: any) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={frontmatter.title} fullWidth={true}>
  <div class="flex min-h-screen">
    <!-- Sidebar Navigation -->
    <aside
      class="w-64 bg-[hsl(var(--sidebar-bg))] border-r border-border hidden md:block p-6 overflow-y-auto transition-colors duration-300"
    >
      <div class="mb-6">
        <input
          type="search"
          placeholder="Buscar notas..."
          class="w-full px-4 py-2 rounded-md border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <nav>
        <slot name="sidebar" />
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-8 bg-background w-full max-w-[800px] mx-auto">
      <article class="prose prose-slate dark:prose-invert max-w-none">
        <div class="mb-8">
          <h1 class="text-4xl font-bold text-foreground mb-4">
            {frontmatter.title}
          </h1>
          {
            frontmatter.tags && (
              <div class="flex gap-2">
                {frontmatter.tags.map((tag: string) => (
                  <span class="note-tag">#{tag}</span>
                ))}
              </div>
            )
          }
        </div>

        <div class="note-content">
          <slot />
        </div>

        <!-- Backlinks & Related Notes -->
        <div class="mt-12 pt-6 border-t">
          <h2 class="text-2xl font-semibold mb-4">Links Relacionados</h2>
          <slot name="backlinks" />
        </div>
      </article>
    </main>

    <!-- Right Sidebar (Table of Contents) -->
    {
      tocHeadings.length > 0 && (
        <aside class="w-64 hidden lg:block p-6 sticky top-0 h-screen overflow-y-auto border-l border-border bg-[hsl(var(--sidebar-bg))] transition-colors duration-300">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-4">
            Nesta página
          </h3>
          <ul class="space-y-2.5 text-sm">
            {tocHeadings.map((heading: any) => (
              <li class={heading.depth === 3 ? "pl-4" : ""}>
                <a
                  href={`#${heading.slug}`}
                  class="block text-muted-foreground hover:text-foreground transition-colors line-clamp-2"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</BaseLayout>

<style>
  .note-content :global(a) {
    color: #2563eb;
    text-decoration: underline;
  }

  .note-content :global(a.internal) {
    color: hsl(var(--primary));
    text-decoration: none;
    font-weight: 500;
    padding: 0.125rem 0.25rem;
    background-color: hsl(var(--primary) / 0.1);
    border-radius: 0.25rem;
    transition: all 0.2s;
  }

  .note-content :global(a.internal:hover) {
    background-color: hsl(var(--primary) / 0.2);
  }

  .note-content :global(h2) {
    font-size: 1.875rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .note-content :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .note-content :global(ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .note-content :global(pre) {
    @apply bg-muted p-4 rounded-md overflow-x-auto mb-4 border border-border;
  }
</style>
