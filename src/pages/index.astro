---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";

const normalizeTitle = (title: string) => {
  return title
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "") // Remove accents
    .replace(/[^a-z0-9\s-]/g, "") // Remove special characters
    .replace(/\s+/g, "-") // Replace spaces with hyphens
    .replace(/-+/g, "-") // Replace multiple hyphens with single hyphen
    .trim(); // Remove leading/trailing spaces
};
---

<BaseLayout title="Guia de Estudos e Simulados Interativos">
  <section
    class="mb-20 text-center animate-in slide-in-from-bottom-8 duration-700"
  >
    <h1
      class="text-5xl md:text-7xl font-extrabold mb-6 tracking-tight text-gradient"
    >
      Desbrave a Nuvem AWS
    </h1>
    <p
      class="mb-10 text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed"
    >
      Aprofunde seus conhecimentos, prepare-se para certificações e domine as
      tecnologias em nuvem com nossos materiais e simulados práticos.
    </p>
    <div class="flex justify-center gap-4">
      <a
        href="/curso"
        class="inline-flex items-center justify-center bg-primary hover:bg-primary/90 text-primary-foreground font-semibold py-3 px-8 rounded-full transition-all duration-300 hover:scale-105 shadow-[0_0_20px_rgba(var(--primary),0.4)]"
      >
        Explorar o Curso <i class="fas fa-arrow-right ml-2"></i>
      </a>
      <a
        href="/simulador"
        class="inline-flex items-center justify-center bg-secondary hover:bg-secondary/80 text-secondary-foreground font-semibold py-3 px-8 rounded-full transition-all duration-300 hover:scale-105"
      >
        Testar Conhecimentos
      </a>
    </div>
  </section>

  <section
    class="mb-20 animate-in slide-in-from-bottom-12 duration-1000 delay-150"
  >
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Módulos do Curso</h2>
      <div class="h-1 w-20 bg-primary mx-auto rounded-full"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        [
          { title: "Fundamentos AWS", icon: "fa-cloud" },
          { title: "Computação", icon: "fa-server" },
          { title: "Armazenamento", icon: "fa-database" },
          { title: "Redes", icon: "fa-network-wired" },
          { title: "Segurança", icon: "fa-shield-alt" },
          { title: "Projetos Práticos", icon: "fa-code" },
        ].map((module) => (
          <div class="glass-card p-8 rounded-2xl hover:-translate-y-2 transition-transform duration-300 group cursor-pointer relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
            <div class="relative z-10">
              <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
                <i class={`fas ${module.icon} text-2xl text-primary`} />
              </div>
              <h3 class="text-xl font-semibold mb-3">{module.title}</h3>
              <a
                href={`/modulos/${normalizeTitle(module.title)}`}
                class="inline-flex items-center text-primary group-hover:text-primary/80 font-medium transition-colors duration-300"
              >
                Saiba mais{" "}
                <i class="fas fa-chevron-right ml-2 text-sm transition-transform group-hover:translate-x-1" />
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mb-12 glass-card p-10 rounded-2xl text-center">
    <h2 class="text-2xl md:text-3xl font-bold mb-8">Conecte-se com a EDN</h2>
    <ul class="flex justify-center gap-6">
      <li>
        <a
          href="https://www.instagram.com/escola_da_nuvem/"
          target="_blank"
          class="w-12 h-12 rounded-full bg-secondary flex items-center justify-center text-foreground hover:bg-primary hover:text-primary-foreground hover:scale-110 transition-all duration-300 shadow-lg"
        >
          <i class="fab fa-instagram text-xl"></i>
        </a>
      </li>
      <li>
        <a
          href="https://www.facebook.com/EscolaDaNuvemOficial"
          target="_blank"
          class="w-12 h-12 rounded-full bg-secondary flex items-center justify-center text-foreground hover:bg-primary hover:text-primary-foreground hover:scale-110 transition-all duration-300 shadow-lg"
        >
          <i class="fab fa-facebook-f text-xl"></i>
        </a>
      </li>
      <li>
        <a
          href="https://www.youtube.com/@escoladanuvem"
          target="_blank"
          class="w-12 h-12 rounded-full bg-secondary flex items-center justify-center text-foreground hover:bg-primary hover:text-primary-foreground hover:scale-110 transition-all duration-300 shadow-lg"
        >
          <i class="fab fa-youtube text-xl"></i>
        </a>
      </li>
      <li>
        <a
          href="https://www.linkedin.com/school/escola-da-nuvem/"
          target="_blank"
          class="w-12 h-12 rounded-full bg-secondary flex items-center justify-center text-foreground hover:bg-primary hover:text-primary-foreground hover:scale-110 transition-all duration-300 shadow-lg"
        >
          <i class="fab fa-linkedin-in text-xl"></i>
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
