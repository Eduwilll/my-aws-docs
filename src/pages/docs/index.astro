---
// src/pages/notes/index.astro
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const notes = await getCollection("notes");
// Content Layer (Astro 6+): glob loader entries expose `id` (e.g. "aws/vpc.md"), not `slug`.
const slugOf = (e: { id: string }) => e.id.replace(/\.mdx?$/, "");
const categories = notes.reduce((acc, note) => {
  const [category] = slugOf(note).split("/");
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(note);
  return acc;
}, {});
---

<BaseLayout title="Notas AWS">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-8">Notas AWS</h1>

    <div class="grid gap-8">
      {
        Object.entries(categories).map(([category, categoryNotes]) => (
          <div class="note-card">
            <h2 class="text-2xl font-semibold mb-4 text-blue-900 dark:text-blue-400 capitalize">
              {category}
            </h2>
            <div class="grid gap-4">
              {categoryNotes
                .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
                .map((note) => (
                  <a href={`/docs/${slugOf(note)}`} class="note-link">
                    <h3 class="text-lg font-medium text-foreground mb-2">
                      {note.data.title}
                    </h3>
                    {note.data.tags && (
                      <div class="flex gap-2">
                        {note.data.tags.map((tag) => (
                          <span class="note-tag">#{tag}</span>
                        ))}
                      </div>
                    )}
                  </a>
                ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>
