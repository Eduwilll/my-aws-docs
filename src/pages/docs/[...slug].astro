---
// src/pages/notes/[...slug].astro
import { getCollection, render } from "astro:content";
import NoteLayout from "../../layouts/NoteLayout.astro";

// Content Layer (Astro 6+): glob loader entries expose `id` (e.g. "aws/vpc.md"), not `slug`.
const slugOf = (e: { id: string }) => e.id.replace(/\.mdx?$/, "");

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((entry) => ({
    // NOTE: frontmatter helpers (e.g. slugOf) are NOT in scope here —
    // getStaticPaths is compiled into a separate chunk, so inline the logic.
    params: { slug: entry.id.replace(/\.mdx?$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Buscar todas as notas para gerar o sidebar
const allNotes = await getCollection("notes");
const organizedNotes = allNotes.reduce((acc, note) => {
  const [category] = slugOf(note).split("/");
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(note);
  return acc;
}, {});
---

<NoteLayout frontmatter={entry.data} slug={slugOf(entry)} headings={headings}>
  <div slot="sidebar">
    {
      Object.entries(organizedNotes).map(([category, notes]) => (
        <div class="mb-6">
          <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">
            {category}
          </h3>
          <ul class="space-y-2">
            {notes.map((note) => (
              <li>
                <a
                  href={`/docs/${slugOf(note)}`}
                  class={`block px-2 py-1 rounded-md text-muted-foreground nav-item-hover ${
                    slugOf(entry) === slugOf(note) ? "nav-item-active" : ""
                  }`}
                >
                  {note.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <Content />
</NoteLayout>
